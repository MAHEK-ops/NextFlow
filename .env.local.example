# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_your_trigger_secret_key
NEXT_PUBLIC_TRIGGER_PUBLIC_API_KEY=tr_pub_your_trigger_public_key

# Transloadit
TRANSLOADIT_KEY=your_transloadit_auth_key
NEXT_PUBLIC_TRANSLOADIT_KEY=your_transloadit_auth_key
TRANSLOADIT_SECRET=your_transloadit_auth_secret

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
